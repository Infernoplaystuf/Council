# ============================================================
# Council — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/
.env/

# Environment / secrets
.env
.env.*
*.secret
api_keys.*

# Vault — all private analysis data, logs, model outputs
vault/

# Temp / OS
*.tmp
*.bak
*.swp
*.swo
~$*
.DS_Store
Thumbs.db
desktop.ini

# Private / local folders
_norton_/
.claude/
.idea/
.vscode/

# Large model artefacts
*.gguf
*.ggml
*.bin
*.safetensors

# Eval / debug run logs
*.log

# Godot scratch / generated
.godot/
*.import
.import/
export_presets.cfg
*.translation
godot-mono-builds/
# Per-user editor state — let each dev keep their own
project.godot.bak
*.tmp.gd
